# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js Build Output
/.next/
/out/
/build/
/dist/

# Documentation & Text Files
*.md
*.txt

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env*.local
.env

# Vercel
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
.cache/

# System & OS Files
.DS_Store
Thumbs.db
